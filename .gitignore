# macOS
.DS_Store
.AppleDouble
.LSOverride

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated by scripts/build-tauri-frontend.mjs for `npm run tauri:build`
# only — a copy of the real web assets, never hand-edited or committed.
web-dist/

# Keys & Secrets
*.key
*.pem
*.id_rsa
.env
.env.local
*credentials*.json

# Logs
logs/
*.log
.codegraph/

# Local-only docs (not tracked) — specific files, not the whole directory,
# so docs/accuracy.md (a real shipped deliverable, linked from README) stays
# trackable. A blanket `docs/` line would also block re-including it: git
# won't look inside an excluded directory even with a `!` negation.
docs/ROADMAP.md
docs/NOTES.md
